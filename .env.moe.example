# moe-hybrid (ADR 0012) — append to a copy of main's .env in the fork's worktree.
# Same COMPOSE_PROJECT_NAME and DATA_DIR as main: the two stacks share the indexed data and
# are run one at a time (the MoE needs nearly all RAM and the GPU).
COMPOSE_PROJECT_NAME=radix
DATA_DIR=/home/cris/radix/data
SOURCES_DIR=/home/cris/radix/data/sources
COMPOSE_FILE=docker-compose.yml:docker-compose.llamacpp.yml
LLM_RUNTIME=external
LLM_PROVIDER=llamacpp
LLM_BASE_URL=http://llamacpp:8080/v1
LLM_MODEL=gpt-oss-120b
LLM_TIMEOUT_S=900
GGUF_DIR=/home/cris/radix-models/gguf
LLAMACPP_MODEL=gpt-oss-120b-MXFP4.gguf
LLAMACPP_CTX=16384
LLAMACPP_THREADS=32
# -b/-ub 8192: the whole RAG prompt in one batch — prefill 160 -> 722 tok/s on the reference
# server (ADR 0012). reasoning_effort=low: gpt-oss's lowest level (Qwen on main runs with none).
LLAMACPP_ARGS=--chat-template-kwargs {"reasoning_effort":"low"} -b 8192 -ub 8192
